[Unit]
Description=Docker Application Container Engine (Rootless)
Documentation=https://docs.docker.com/go/rootless/
Requires=dbus.socket

[Service]
Environment=PATH={{ docker_rootless_bin_dir }}:/sbin:/usr/sbin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
{% if docker_rootless_rootlesskit_net | length > 0 %}
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET={{ docker_rootless_rootlesskit_net }}
{% endif %}
{% if docker_rootless_rootlesskit_port_driver | length > 0 %}
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER={{ docker_rootless_rootlesskit_port_driver }}
{% endif %}
{% for env_key, env_val in docker_rootless_rootlesskit_env.items() %}
Environment={{ env_key }}={{ env_val }}
{% endfor %}
ExecStart={{ docker_rootless_bin_dir }}/dockerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
